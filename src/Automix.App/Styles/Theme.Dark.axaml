<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="Bg">#0F1115</Color>
    <Color x:Key="PanelBg">#151922</Color>
    <Color x:Key="PanelBorder">#252B38</Color>
    <Color x:Key="Text">#E8ECF2</Color>
    <Color x:Key="TextDim">#98A2B3</Color>
    <Color x:Key="Danger">#E5484D</Color>

    <Color x:Key="GroupA">#2F6FED</Color>
    <Color x:Key="GroupB">#2ECC71</Color>
    <Color x:Key="GroupC">#F39C12</Color>
    <Color x:Key="GroupD">#9B59B6</Color>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource PanelBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.9"/>
  </Style>
</Styles>
